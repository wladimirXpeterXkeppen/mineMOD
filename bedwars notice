  /* ================================================================
     Toasts
     ================================================================ */
  const Toasts = (() => {
    let container = null;
    function getContainer() {
      if (container && container.isConnected) return container;
      let c = byId("__bwn_stack");
      if (!c) { c = document.createElement("div"); c.id = "__bwn_stack"; document.body.appendChild(c); }
      container = c;
      return c;
    }
    function teamColor(t) {
      const k = teamKey(t);
      return TEAM_COLORS[k] || TEAM_COLORS[k.replace(/_/g, " ")] || "#ffffff";
    }
    function teamIconURL(t, kind) {
      if (kind === "eliminated") return SKULL_ICON;
      const k = teamKey(t);
      return TEAM_ICONS[k] || TEAM_ICONS[k.replace(/_/g, " ")] || SKULL_ICON;
    }

    function show({ kind, team, line1, line1Color, line2, line2Before, line2Red, isOwn }) {
      const c = getContainer();
      const el = document.createElement("div");
      el.className = "__bwn_toast";
      if (isOwn) el.classList.add("__bwn_own");

      const iconURL = teamIconURL(team, kind);
      const color = line1Color || "#ffffff";

      let subHtml = "";
      if (line2 != null) subHtml = escHtml(line2);
      else if (line2Before != null || line2Red != null) {
        subHtml = escHtml(line2Before || "") + '<span class="__bwn_red">' + escHtml(line2Red || "") + "</span>";
      }

      el.innerHTML = `<div class="__bwn_icon"><img src="${escHtml(iconURL)}" alt=""></div><div class="__bwn_body"><span class="__bwn_title" style="color:${isOwn ? "#ff8899" : color};">${escHtml(line1)}</span><span class="__bwn_sub">${subHtml}</span></div>`;
      c.appendChild(el);
      requestAnimationFrame(() => el.classList.add("__bwn_show"));

      const duration = isOwn
        ? clamp(cfg("ownBedDuration"), 1000, 15000)
        : clamp(cfg("duration"), 500, 10000);
      const maxToasts = clamp(cfg("maxToasts"), 1, 10);

      const all = Array.from(c.children);
      if (all.length > maxToasts) {
        for (let i = 0; i < all.length - maxToasts; i++) {
          const old = all[i];
          old.classList.remove("__bwn_show");
          setTimeout(() => { try { old.remove(); } catch (e) {} }, 250);
        }
      }
      setTimeout(() => {
        el.classList.remove("__bwn_show");
        setTimeout(() => { try { el.remove(); } catch (e) {} }, 250);
      }, duration);
    }
    function destroy() {
      if (container) { try { container.remove(); } catch (e) {} container = null; }
    }
    return { show, destroy, teamColor };
  })();

  /* ================================================================
     Log
     ================================================================ */
  const Log = (() => {
    const lines = [];
    let el = null;
    function attach(elRef) { el = elRef; }
    function push(text, cls) {
      const time = new Date().toLocaleTimeString("ja-JP", { hour12: false }).slice(0, 8);
      const line = `[${time}] ${text}`;
      lines.push({ text: line, cls });
      if (lines.length > 50) lines.shift();
      if (!el) return;
      el.innerHTML = lines.map(l => `<div class="${l.cls || ""}">${escHtml(l.text)}</div>`).join("");
      el.scrollTop = el.scrollHeight;
    }
    return { push, attach };
  })();

  /* ================================================================
     パケット処理
     ================================================================ */
  function handleBedDestroyed(data) {
    if (!cfg("bedDestroy")) { Log.push("1502 (Bed) — 設定OFF", ""); return; }
    if (!Array.isArray(data)) { Log.push("1502 (Bed) — 不正データ", ""); return; }

    const username = data[0];
    const team = data[1];
    if (!username || !team) { Log.push("1502 (Bed) — データ欠損", ""); return; }

    MatchState.markBedDestroyed(team);

    const isMyTeam = TeamInfo.isMyTeam(team);

    if (isMyTeam && cfg("ownBedSpecial")) {
      Log.push(`★★★ 自分のベッド破壊! (${team}) by ${username}`, "log-own");
      Toasts.show({
        kind: "bed", team,
        line1: "⚠ YOUR BED DESTROYED ⚠",
        line1Color: "#ff2244",
        line2: "by " + username,
        isOwn: true
      });
      Sound.play("ownBed", cfg("ownBedVolume"));
    } else {
      Log.push(`★ ベッド破壊: ${team} by ${username}`, "log-hit");
      Toasts.show({
        kind: "bed", team,
        line1: String(team).toUpperCase() + " TEAM BED DESTROYED",
        line1Color: Toasts.teamColor(team),
        line2: "by " + username,
        isOwn: false
      });
      Sound.play("bed");
    }
  }

  function handleTeamEliminated(team) {
    if (!cfg("teamElim")) { Log.push("1510 (Elim) — 設定OFF", ""); return; }
    if (!team) { Log.push("1510 (Elim) — データ欠損", ""); return; }

    if (cfg("dedupeElim") && MatchState.wasEliminated(team)) {
      Log.push(`↺ 重複スキップ (既通知): ${team}`, "log-skip");
      return;
    }

    if (cfg("filterLeavers")) {
      const bedWasDestroyed = MatchState.isBedDestroyed(team);
      const hasRecentDeath = MatchState.hasRecentDeath();

      if (!bedWasDestroyed && !hasRecentDeath) {
        Log.push(`🚫 退出と判定: ${team} (bed:${bedWasDestroyed} death:${hasRecentDeath})`, "log-skip");
        return;
      }
    }

    MatchState.markEliminated(team);

    const isMyTeam = TeamInfo.isMyTeam(team);

    if (isMyTeam) {
      Log.push(`★★★ 自分のチーム全滅! (${team})`, "log-own");
      Toasts.show({
        kind: "eliminated", team,
        line1: "☠ YOUR TEAM ELIMINATED ☠",
        line1Color: "#ff2244",
        line2Before: "game over",
        line2Red: "",
        isOwn: true
      });
      Sound.play("eliminated");
    } else {
      Log.push(`★ チーム全滅: ${team}`, "log-hit");
      Toasts.show({
        kind: "eliminated", team,
        line1: String(team).toUpperCase() + " TEAM",
        line1Color: Toasts.teamColor(team),
        line2Before: "has been ",
        line2Red: "eliminated",
        isOwn: false
      });
      Sound.play("eliminated");
    }
  }

  function onMessage(packetID, data) {
    if (!cfg("enabled")) return;

    MatchState.checkMatchChange();

    if (packetID === OPCODE.BATCH && Array.isArray(data)) {
      for (let i = 0; i < data.length; i++) {
        const item = data[i];
        if (Array.isArray(item) && item.length === 2) {
          dispatchInner(item[0], item[1]);
        }
      }
      for (let i = 2; i < data.length - 1; i += 2) {
        const innerID = data[i];
        const innerData = data[i + 1];
        if (typeof innerID === "number") {
          dispatchInner(innerID, innerData);
        }
      }
      return;
    }

    dispatchInner(packetID, data);
  }

  function dispatchInner(id, data) {
    if (id === OPCODE.BED_DESTROYED) handleBedDestroyed(data);
    else if (id === OPCODE.TEAM_ELIMINATED) handleTeamEliminated(data);
    else if (id === OPCODE.PLAYER_DEAD) MatchState.markDeath();
  }

  /* ================================================================
     Room Hook
     ================================================================ */
  let _hookedRoom = null;
  let _checkTimer = null;
  let _rawCount = 0;

  function tryHook() {
    const room = Game.room;
    if (!room || typeof room.onMessage !== "function") return;
    if (_hookedRoom === room) return;

    _hookedRoom = room;
    try {
      room.onMessage("*", (packetID, data) => {
        _rawCount++;
        try { onMessage(packetID, data); }
        catch (e) { Log.push("ERR: " + e.message, ""); }
      });
      Log.push("room フック完了", "log-hit");
    } catch (e) {
      Log.push("フック失敗: " + e.message, "");
    }
  }

  /* ================================================================
     Panel
     ================================================================ */
  let _panelEl = null;
  let _dragging = false;
  const _dragOffset = { x: 0, y: 0 };

  function buildHTML() {
