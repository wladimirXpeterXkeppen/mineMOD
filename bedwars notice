        </div>

        <div class="section">My Team</div>
        <div class="row">
          <label>My Team</label>
          <span id="__bwn_myteam" style="font-size:11px;color:#23bd61;font-weight:700;">(検出中...)</span>
        </div>

        <div class="section">Events</div>
        <div class="row">
          <label>Bed Destroy</label>
