/*
 * BedWars Notifications v1.5
 * - バッチパケット対応
 * - 退出フィルタ (相手が抜けただけでは通知しない)
 * - 自分のベッド破壊の特別通知 + カスタム音
 * - 全滅通知の重複防止
 * - HTML Audio + Web Audio ハイブリッド
 */
(function () {
  "use strict";

  if (window.__BW_NOTIF__) {
    try { window.__BW_NOTIF__.destroy(); } catch (e) {}
  }

  /* ================================================================
     定数
     ================================================================ */
  const PREFIX = "__bwnotif__:";

  const OPCODE = Object.freeze({
    BATCH: 3,
    PLAYER_DEAD: 6,
    GOT_DAMAGE: 512,
    PLAYER_GOT_DAMAGE: 524,
    BED_DESTROYED: 1502,
    TEAM_ELIMINATED: 1510
  });

  const TEAM_COLORS = Object.freeze({
    red: "#F33", blue: "#6EC9E8", green: "#8AFF3F", yellow: "#FCCF1A",
    purple: "#D147EA", orange: "#F09925", white: "#F4F4F4",
    gray: "#9AA0B4", grey: "#9AA0B4",
    "light blue": "#3AF9CF", light_blue: "#3AF9CF", aqua: "#3AF9CF"
  });

  const TEAM_ICONS = Object.freeze({
    red: "https://minefun.io/assets/640-DSh60gjK.png",
    blue: "https://minefun.io/assets/1046-yBpzjP02.png",
    green: "https://minefun.io/assets/1048-DARFgmWy.png",
    yellow: "https://minefun.io/assets/1058-zkWt4hVU.png",
    purple: "https://minefun.io/assets/1054-BB_QI2Pe.png",
    orange: "https://minefun.io/assets/1052-Ch3SkaG5.png",
    white: "https://minefun.io/assets/1056-D9V-wvsD.png",
    "light blue": "https://minefun.io/assets/1050-CsZnjCVk.png",
    light_blue: "https://minefun.io/assets/1050-CsZnjCVk.png",
    aqua: "https://minefun.io/assets/1050-CsZnjCVk.png"
  });

  const SKULL_ICON = "https://minefun.io/assets/skull-y4aiBsYt.png";

  const SOUND_URLS = Object.freeze({
    bed: "https://minefun.io/assets/select-iaFF95Ap.mp3",
    eliminated: "https://minefun.io/assets/newPhase-Cd7o-1xF.mp3",
    ownBed: "https://www.image2url.com/r2/default/audio/1790590349862-913b9e83-ce5d-44ec-8169-11c2fccaa9ca.mp3"
  });

  /* ================================================================
     Utils
     ================================================================ */
  const byId = (id) => document.getElementById(id);
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const escHtml = (s) => {
    const map = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
    return String(s).replace(/[&<>"']/g, (c) => map[c]);
  };
  const teamKey = (t) => String(t).toLowerCase().replace(/-/g, "_");

  /* ================================================================
     Config
     ================================================================ */
  const DEFAULTS = {
    enabled: true, bedDestroy: true, teamElim: true,
    sound: true, volume: 0.5, duration: 3000,
    maxToasts: 5, panelOpen: true, debug: false,
    filterLeavers: true, deathWindowMs: 3000,
    ownBedSpecial: true, ownBedDuration: 5000,
    ownBedVolume: 0.8,
    dedupeElim: true
  };

  const _cfg = Object.create(null);
  function cfg(key) {
    if (_cfg[key] !== undefined) return _cfg[key];
    let saved;
    try {
      const raw = localStorage.getItem(PREFIX + key);
      saved = raw === null ? undefined : JSON.parse(raw);
    } catch (e) { saved = undefined; }
    const val = saved !== undefined && saved !== null ? saved : DEFAULTS[key];
    _cfg[key] = val;
    return val;
  }
  function cfgSet(key, value) {
    if (_cfg[key] === value && (value === null || typeof value !== "object")) return;
    _cfg[key] = value;
    try { localStorage.setItem(PREFIX + key, JSON.stringify(value)); } catch (e) {}
  }

  /* ================================================================
     Game Access
     ================================================================ */
  const Game = {
    getStores() {
      try {
        const vueApp = window.app;
        if (!vueApp) return null;
        const provides =
          (vueApp._vnode && vueApp._vnode.component && vueApp._vnode.component.appContext && vueApp._vnode.component.appContext.provides) ||
          (vueApp._context && vueApp._context.provides);
        if (!provides) return null;
        const sym = Object.getOwnPropertySymbols(provides).find(s => provides[s] && provides[s]._s);
        return sym ? provides[sym]._s : null;
      } catch (e) { return null; }
    },
    get gameWorld() {
      try {
        const s = this.getStores();
        if (!s) return null;
        const gs = s.get("gameState");
        return gs ? (gs.gameWorld || null) : null;
      } catch (e) { return null; }
    },
    get player() {
      try {
        const gw = this.gameWorld;
        return gw ? gw.player : null;
      } catch (e) { return null; }
    },
    get room() {
      try {
        const gw = this.gameWorld;
        return (gw && gw.server && gw.server.room) ? gw.server.room : null;
      } catch (e) { return null; }
    },
    get audioListener() {
      try {
        const gw = this.gameWorld;
        if (!gw || !gw.systemsManager) return null;
        const systems = gw.systemsManager.activeSystems || [];
        for (const s of systems) {
          if (s && s.audioListener) return s.audioListener;
        }
      } catch (e) {}
      return null;
    }
  };

  /* ================================================================
     TeamInfo
     ================================================================ */
  const TeamInfo = {
    _cachedTeam: null,
    _lastCheck: 0,
    _cacheMs: 2000,

    getMyTeam() {
      const now = performance.now();
      if (this._cachedTeam && now - this._lastCheck < this._cacheMs) {
        return this._cachedTeam;
      }
      this._lastCheck = now;

      let team = null;

      try {
        const p = Game.player;
        if (p) {
          team = p.team || p.teamId || p.teamName || p.teamColor;
          if (team) {
            team = this._normalize(team);
            this._cachedTeam = team;
            Log.push(`[team] player.team = ${team}`, "log-hit");
            return team;
          }
        }
      } catch (e) {}

      try {
        const stores = Game.getStores();
        if (stores) {
          const bws = stores.get("bedWarsStore");
          if (bws) {
            team = bws.myTeam || bws.team || bws.playerTeam;
            if (team) {
              team = this._normalize(team);
              this._cachedTeam = team;
              return team;
            }
          }
        }
      } catch (e) {}

      try {
        const stores = Game.getStores();
        if (stores) {
          const rs = stores.get("roomState");
          if (rs) {
            team = rs.myTeam || rs.team;
            if (team) {
              team = this._normalize(team);
              this._cachedTeam = team;
              return team;
            }
          }
        }
      } catch (e) {}

      try {
        const gw = Game.gameWorld;
        if (gw) {
          team = gw.myTeam || gw.playerTeam;
          if (team) {
            team = this._normalize(team);
            this._cachedTeam = team;
            return team;
          }
        }
      } catch (e) {}

      return null;
    },

    _normalize(t) {
      if (!t) return null;
      const s = String(t).toLowerCase().trim();
      return s.replace(/-/g, " ");
    },

    isMyTeam(team) {
      const my = this.getMyTeam();
      if (!my || !team) return false;
      return this._normalize(team) === my;
    },

    reset() {
      this._cachedTeam = null;
      this._lastCheck = 0;
    }
  };

  /* ================================================================
     Sound v2 — HTML Audio + Web Audio ハイブリッド
     ================================================================ */
  const Sound = (() => {
    const bufferCache = new Map();
    const fetching = new Map();
    const audioPool = new Map();

    /* ---------- Web Audio (MineFun公式用) ---------- */
    async function loadBuffer(url, ctx) {
      if (bufferCache.has(url)) return bufferCache.get(url);
      if (fetching.has(url)) return fetching.get(url);
      const p = (async () => {
        try {
          const res = await fetch(url, { mode: "cors" });
          if (!res.ok) throw new Error("HTTP " + res.status);
          const arr = await res.arrayBuffer();
          const buf = await ctx.decodeAudioData(arr);
          bufferCache.set(url, buf);
          return buf;
        } catch (e) {
          console.warn("[BWN] WebAudio load fail:", url, e.message);
          return null;
        } finally { fetching.delete(url); }
      })();
      fetching.set(url, p);
      return p;
    }

    async function playWebAudio(url, volume) {
      const listener = Game.audioListener;
      if (!listener || !listener.context) return false;

      const ctx = listener.context;
      if (ctx.state === "suspended") {
        try { await ctx.resume(); } catch (e) {}
      }

      const buffer = await loadBuffer(url, ctx);
      if (!buffer) return false;
      if (volume <= 0) return false;

      let master = 1;
      try {
        if (typeof listener.getMasterVolume === "function") {
          master = listener.getMasterVolume() || 1;
        }
      } catch (e) {}

      const src = ctx.createBufferSource();
      src.buffer = buffer;
      const gain = ctx.createGain();
      gain.gain.value = volume * master;
      src.connect(gain);

      try {
        const input = typeof listener.getInput === "function"
          ? listener.getInput() : ctx.destination;
        gain.connect(input);
      } catch (e) {
        try { gain.connect(ctx.destination); } catch (e2) {}
      }

      src.start(0);
      return true;
    }

    /* ---------- HTML Audio (外部URL用) ---------- */
    function playHtmlAudio(url, volume) {
      try {
        let audio = audioPool.get(url);
        if (!audio) {
          audio = new Audio();
          audio.src = url;
          audio.preload = "auto";
          audioPool.set(url, audio);
        }
        audio.volume = clamp(volume, 0, 1);
        try { audio.currentTime = 0; } catch (e) {}

        const p = audio.play();
        if (p && p.catch) {
          p.catch((err) => {
            console.warn("[BWN] HTML Audio play fail:", err.message);
          });
        }
        return true;
      } catch (e) {
        console.warn("[BWN] HTML Audio error:", e.message);
        return false;
      }
    }

    /* ---------- メイン再生 ---------- */
    async function playUrl(url, volumeOverride) {
      if (!cfg("sound")) return;
      if (!url) return;

      const volume = clamp(
        volumeOverride != null ? volumeOverride : cfg("volume"),
        0, 1
      );
      if (volume <= 0) return;

      if (url.includes("minefun.io")) {
        const ok = await playWebAudio(url, volume);
        if (ok) return;
      }
      playHtmlAudio(url, volume);
    }

    function play(kind, volumeOverride) {
      const url = SOUND_URLS[kind];
      return playUrl(url, volumeOverride);
    }

    function preload() {
      const l = Game.audioListener;
      if (l && l.context) {
        Object.values(SOUND_URLS).forEach((u) => {
          if (u.includes("minefun.io")) {
            loadBuffer(u, l.context).catch(() => {});
          }
        });
      }
      Object.values(SOUND_URLS).forEach((u) => {
        if (!u.includes("minefun.io") && !audioPool.has(u)) {
          try {
            const a = new Audio();
            a.src = u;
            a.preload = "auto";
            a.volume = 0;
            audioPool.set(u, a);
          } catch (e) {}
        }
      });
    }

    return { play, playUrl, preload, playHtmlAudio, playWebAudio };
  })();

  /* ================================================================
     Match State
     ================================================================ */
  const MatchState = {
    _bedDestroyedTeams: new Set(),
    _recentDeaths: [],
    _notifiedEliminatedTeams: new Set(),
    _lastReset: 0,
    _playerPositionMemory: null,
    _lastRoom: null,

    markBedDestroyed(team) {
      this._bedDestroyedTeams.add(teamKey(team));
    },

    markDeath() {
      this._recentDeaths.push({ at: performance.now() });
      const now = performance.now();
      const windowMs = cfg("deathWindowMs");
      this._recentDeaths = this._recentDeaths.filter(d => now - d.at < windowMs);
    },

    hasRecentDeath() {
      const now = performance.now();
      const windowMs = cfg("deathWindowMs");
      return this._recentDeaths.some(d => now - d.at < windowMs);
    },

    isBedDestroyed(team) {
      return this._bedDestroyedTeams.has(teamKey(team));
    },

    wasEliminated(team) {
      return this._notifiedEliminatedTeams.has(teamKey(team));
    },

    markEliminated(team) {
      this._notifiedEliminatedTeams.add(teamKey(team));
    },

    reset(reason = "manual") {
      const hadBeds = this._bedDestroyedTeams.size;
      const hadElims = this._notifiedEliminatedTeams.size;
      this._bedDestroyedTeams.clear();
      this._recentDeaths = [];
      this._notifiedEliminatedTeams.clear();
      this._lastReset = performance.now();
      TeamInfo.reset();
      Log.push(`[state] reset (${reason}) — beds:${hadBeds} elims:${hadElims}`, "");
    },

    checkMatchChange() {
      try {
        const room = Game.room;
        if (!room) return;
        if (this._lastRoom !== room) {
          if (this._lastRoom !== null) {
            this.reset("room change");
          }
          this._lastRoom = room;
          return;
        }
        const now = performance.now();
        if (this._lastReset && now - this._lastReset > 30000) {
          const p = Game.player;
          if (p && p.position) {
            const pos = p.position;
            if (this._playerPositionMemory) {
              const dx = pos.x - this._playerPositionMemory.x;
              const dz = pos.z - this._playerPositionMemory.z;
              if (Math.sqrt(dx * dx + dz * dz) > 100) {
                this.reset("teleport");
              }
            }
            this._playerPositionMemory = { x: pos.x, z: pos.z };
          }
        }
      } catch (e) {}
    }
  };

