          <label>Volume</label>
          <input type="range" id="__bwn_vol" min="0" max="1" step="0.05" value="${cfg("volume")}">
          <div class="val" id="__bwn_vol_v">${Math.round(cfg("volume") * 100)}%</div>
        </div>
        <div class="row">
          <label>Own Bed Vol</label>
          <input type="range" id="__bwn_ownvol" min="0" max="1" step="0.05" value="${cfg("ownBedVolume")}">
          <div class="val" id="__bwn_ownvol_v">${Math.round(cfg("ownBedVolume") * 100)}%</div>
        </div>

        <div class="section">Display</div>
        <div class="row">
          <label>Duration</label>
          <input type="range" id="__bwn_dur" min="1000" max="8000" step="250" value="${cfg("duration")}">
          <div class="val" id="__bwn_dur_v">${(cfg("duration") / 1000).toFixed(1)}s</div>
        </div>
        <div class="row">
          <label>Own Duration</label>
          <input type="range" id="__bwn_owndur" min="2000" max="12000" step="500" value="${cfg("ownBedDuration")}">
          <div class="val" id="__bwn_owndur_v">${(cfg("ownBedDuration") / 1000).toFixed(1)}s</div>
        </div>

        <div class="section">Debug</div>
        <div class="row" style="flex-direction:column;align-items:stretch;gap:6px;">
          <div class="log" id="__bwn_log"></div>
        </div>

        <div class="section">Test</div>
        <div class="row">
          <button class="btn" id="__bwn_test1">Bed</button>
          <button class="btn" id="__bwn_test2">Elim</button>
