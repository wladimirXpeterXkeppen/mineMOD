  }

  function updateMyTeamDisplay() {
    const el = byId("__bwn_myteam");
    if (!el) return;
    const myTeam = TeamInfo.getMyTeam();
    if (myTeam) {
      const color = Toasts.teamColor(myTeam);
      el.innerHTML = `<span class="team-badge" style="background:${color};color:#000;">${escHtml(myTeam.toUpperCase())}</span>`;
    } else {
      el.textContent = "(未検出)";
      el.style.color = "#807f7f";
    }
  }

  function initPanel() {
    if (_panelEl) return;
    injectStyles();
    _panelEl = document.createElement("div");
    _panelEl.id = "__bwn_panel";
    _panelEl.innerHTML = buildHTML();
    document.body.appendChild(_panelEl);

    const tab = document.createElement("div");
    tab.id = "__bwn_tab";
    tab.textContent = "BWN";
    document.body.appendChild(tab);

    tab.addEventListener("click", () => {
      _panelEl.classList.add("open");
      tab.style.display = "none";
      cfgSet("panelOpen", true);
    });
    byId("__bwn_hide").addEventListener("click", () => {
      _panelEl.classList.remove("open");
      tab.style.display = "block";
      cfgSet("panelOpen", false);
    });

    Log.attach(byId("__bwn_log"));

    const bindTog = (id, key) => {
      const el = byId(id);
      if (!el) return;
      el.addEventListener("click", () => {
        const now = !el.classList.contains("on");
        el.classList.toggle("on", now);
        cfgSet(key, now);
      });
    };
    bindTog("__bwn_en", "enabled");
    bindTog("__bwn_bed", "bedDestroy");
    bindTog("__bwn_elim", "teamElim");
    bindTog("__bwn_snd", "sound");
    bindTog("__bwn_leaver", "filterLeavers");
    bindTog("__bwn_dedup", "dedupeElim");

    const bindSlider = (sId, vId, key, fmt) => {
      const s = byId(sId), v = byId(vId);
      if (!s) return;
      s.oninput = () => {
        const n = parseFloat(s.value);
        v.textContent = fmt(n);
        cfgSet(key, n);
      };
    };
    bindSlider("__bwn_vol", "__bwn_vol_v", "volume", (v) => Math.round(v * 100) + "%");
    bindSlider("__bwn_ownvol", "__bwn_ownvol_v", "ownBedVolume", (v) => Math.round(v * 100) + "%");
    bindSlider("__bwn_dur", "__bwn_dur_v", "duration", (v) => (v / 1000).toFixed(1) + "s");
    bindSlider("__bwn_owndur", "__bwn_owndur_v", "ownBedDuration", (v) => (v / 1000).toFixed(1) + "s");

    byId("__bwn_test1").addEventListener("click", () => {
      Toasts.show({
        kind: "bed", team: "red",
        line1: "RED TEAM BED DESTROYED",
        line1Color: Toasts.teamColor("red"),
        line2: "by TestPlayer"
      });
      Sound.play("bed");
    });
    byId("__bwn_test2").addEventListener("click", () => {
      Toasts.show({
        kind: "eliminated", team: "blue",
        line1: "BLUE TEAM",
        line1Color: Toasts.teamColor("blue"),
        line2Before: "has been ",
        line2Red: "eliminated"
      });
      Sound.play("eliminated");
    });
    byId("__bwn_testown").addEventListener("click", () => {
      Toasts.show({
        kind: "bed", team: "red",
        line1: "⚠ YOUR BED DESTROYED ⚠",
        line1Color: "#ff2244",
        line2: "by TestPlayer",
        isOwn: true
      });
      Sound.play("ownBed", cfg("ownBedVolume"));
    });
    byId("__bwn_testbatch").addEventListener("click", () => {
      onMessage(3, [0, 0, 1502, ["BatchPlayer", "green"], 1510, "yellow"]);
    });
    byId("__bwn_refresh").addEventListener("click", () => {
      TeamInfo.reset();
      updateMyTeamDisplay();
      Log.push("チーム情報を再取得", "");
    });

    const header = byId("__bwn_header");
    header.addEventListener("mousedown", (e) => {
      if (e.target.closest("button")) return;
      _dragging = true;
      const r = _panelEl.getBoundingClientRect();
      _dragOffset.x = e.clientX - r.left;
      _dragOffset.y = e.clientY - r.top;
      e.preventDefault();
    });
    document.addEventListener("mousemove", (e) => {
      if (!_dragging) return;
      const x = clamp(e.clientX - _dragOffset.x, 0, innerWidth - _panelEl.offsetWidth);
      const y = clamp(e.clientY - _dragOffset.y, 0, innerHeight - _panelEl.offsetHeight);
      _panelEl.style.left = x + "px";
      _panelEl.style.top = y + "px";
    });
    document.addEventListener("mouseup", () => { _dragging = false; });

    setInterval(() => {
      if (!_panelEl) return;
      _panelEl.classList.toggle("on", cfg("enabled") && !!_hookedRoom);
    }, 200);

    setInterval(updateMyTeamDisplay, 2000);
    updateMyTeamDisplay();

    if (cfg("panelOpen")) _panelEl.classList.add("open");
    else tab.style.display = "block";
  }

  /* ================================================================
     Boot
     ================================================================ */
  function boot() {
    injectStyles();
    initPanel();
    _checkTimer = setInterval(tryHook, 1000);
    tryHook();
    setTimeout(() => { if (Game.audioListener) Sound.preload(); }, 2000);
  }

  /* ================================================================
     Public API
     ================================================================ */
  const API = {
    version: "1.5",

    testBed: (team = "red", player = "TestPlayer") => {
      Toasts.show({
        kind: "bed", team,
        line1: String(team).toUpperCase() + " TEAM BED DESTROYED",
        line1Color: Toasts.teamColor(team),
        line2: "by " + player
      });
      Sound.play("bed");
    },
    testElim: (team = "blue") => {
      Toasts.show({
        kind: "eliminated", team,
        line1: String(team).toUpperCase() + " TEAM",
        line1Color: Toasts.teamColor(team),
        line2Before: "has been ",
        line2Red: "eliminated"
      });
      Sound.play("eliminated");
    },
    testOwnBed: () => {
      Toasts.show({
        kind: "bed", team: "red",
        line1: "⚠ YOUR BED DESTROYED ⚠",
        line1Color: "#ff2244",
        line2: "by TestPlayer",
        isOwn: true
      });
      Sound.play("ownBed", cfg("ownBedVolume"));
    },

    getMyTeam: () => TeamInfo.getMyTeam(),
    isMyTeam: (team) => TeamInfo.isMyTeam(team),
    refreshTeam: () => { TeamInfo.reset(); updateMyTeamDisplay(); },
    resetState: () => MatchState.reset("manual"),

    status: () => ({
      enabled: cfg("enabled"),
      myTeam: TeamInfo.getMyTeam(),
      hooked: !!_hookedRoom,
      rawPackets: _rawCount,
      notifiedElims: Array.from(MatchState._notifiedEliminatedTeams)
    }),

    showPanel: () => {
      initPanel();
      if (_panelEl) _panelEl.classList.add("open");
      const t = byId("__bwn_tab");
      if (t) t.style.display = "none";
    },
    hidePanel: () => {
      if (_panelEl) _panelEl.classList.remove("open");
      const t = byId("__bwn_tab");
      if (t) t.style.display = "block";
    },

    destroy() {
      if (_checkTimer) { clearInterval(_checkTimer); _checkTimer = null; }
      Toasts.destroy();
      if (_panelEl) { try { _panelEl.remove(); } catch (e) {} _panelEl = null; }
      const t = byId("__bwn_tab");
      if (t) t.remove();
      const s = byId("__bwn_styles");
      if (s) s.remove();
      _hookedRoom = null;
      delete window.__BW_NOTIF__;
      delete window.BWN;
      console.log("[BWN] destroyed");
    }
  };

  window.__BW_NOTIF__ = API;
  window.BWN = API;

  if (document.body) boot();
  else {
    new MutationObserver((_, obs) => {
      if (document.body) { obs.disconnect(); boot(); }
    }).observe(document.documentElement, { childList: true });
  }

  console.log("%c✦ BedWars Notifications v1.5", "color:#ffcc33;font-weight:700;background:#0f1015;padding:3px 8px;border-radius:4px");
  console.log("  BWN.testBed()     // 通常ベッド通知テスト");
  console.log("  BWN.testOwnBed()  // 自分のベッド通知テスト (カスタム音)");
  console.log("  BWN.status()      // 状態確認");
  console.log("  BWN.destroy()     // 完全削除");
})();
