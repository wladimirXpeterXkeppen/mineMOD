        <div class="row">
          <button class="btn" id="__bwn_testown" style="flex:1;background:#3d0d0d;border-color:#ff2244;color:#ff8899;">Test MY Bed</button>
        </div>
        <div class="row">
          <button class="btn" id="__bwn_testbatch" style="flex:1;">Test Batch</button>
        </div>
        <div class="row">
          <button class="btn" id="__bwn_refresh" style="flex:1;">Refresh Team</button>
        </div>
